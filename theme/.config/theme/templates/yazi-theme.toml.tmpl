# Generated by theme-ssot — do not edit by hand
[mgr]
cwd = { fg = "{{ primary }}", bold = true }
hovered = { fg = "{{ on_primary }}", bg = "{{ primary }}", bold = true }
preview_hovered = { fg = "{{ on_primary }}", bg = "{{ primary }}", bold = true }
find_keyword = { fg = "{{ tertiary }}", bold = true }
find_position = { fg = "{{ secondary }}", bg = "reset", bold = true }
marker_copied = { fg = "{{ tertiary }}", bg = "{{ tertiary }}", bold = true }
marker_cut = { fg = "{{ error }}", bg = "{{ error }}", bold = true }
marker_selected = { fg = "{{ primary }}", bg = "{{ primary }}", bold = true }
tab_active = { fg = "{{ on_primary }}", bg = "{{ primary }}", bold = true }
tab_inactive = { fg = "{{ on_surface_variant }}", bg = "{{ surface_container }}" }
border_symbol = "│"
border_style = { fg = "{{ outline }}" }

[status]
separator_open = ""
separator_close = ""
separator_style = { fg = "{{ primary_container }}", bg = "{{ primary_container }}" }
mode_normal = { fg = "{{ on_primary }}", bg = "{{ primary }}", bold = true }
mode_select = { fg = "{{ on_primary }}", bg = "{{ secondary }}", bold = true }
mode_unset = { fg = "{{ on_primary }}", bg = "{{ tertiary }}", bold = true }
progress_label = { fg = "{{ on_surface }}", bold = true }
progress_normal = { fg = "{{ background }}", bg = "{{ primary }}" }
progress_error = { fg = "{{ background }}", bg = "{{ error }}" }
permissions_t = { fg = "{{ tertiary }}", bold = true }
permissions_r = { fg = "{{ primary }}", bold = true }
permissions_w = { fg = "{{ secondary }}", bold = true }
permissions_x = { fg = "{{ tertiary }}", bold = true }
permissions_s = { fg = "{{ on_surface_variant }}", bold = true }

[filetype]
rules = [
  { mime = "image/*", fg = "{{ tertiary }}" },
  { mime = "video/*", fg = "{{ primary }}" },
  { mime = "audio/*", fg = "{{ secondary }}" },
  { mime = "application/pdf", fg = "{{ error }}" },
  { mime = "application/zip", fg = "{{ outline }}" },
  { mime = "text/*", fg = "{{ on_surface }}" },
  { url = "*/", fg = "{{ primary }}" },
]
