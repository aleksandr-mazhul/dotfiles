# Generated by theme-ssot — do not edit by hand

[flags]
hide_table_gap = true
dot_marker = false
left_legend = true

[styles.widgets]
border_colour = "{{ surface_variant }}"
selected_border_colour = "{{ primary }}"
bg_colour = "{{ background }}"
widget_title = { colour = "{{ primary }}", bold = true }
text = { colour = "{{ on_surface }}" }
selected_text = { colour = "{{ on_primary }}", bg_colour = "{{ primary }}", bold = true }
disabled_text = { colour = "{{ on_surface_variant }}" }

[styles.tables]
headers = { colour = "{{ secondary }}", bold = true }

[styles.graphs]
graph_colour = "{{ outline }}"
legend_text = { colour = "{{ on_surface_variant }}" }

[styles.cpu]
all_entry_colour = "{{ on_surface }}"
avg_entry_colour = "{{ primary }}"
cpu_core_colours = [
  "{{ primary }}",
  "{{ secondary }}",
  "{{ tertiary }}",
  "{{ outline }}",
  "{{ primary }}",
  "{{ secondary }}",
  "{{ tertiary }}",
  "{{ outline }}",
]

[styles.memory]
ram_colour = "{{ primary }}"
cache_colour = "{{ secondary }}"
swap_colour = "{{ tertiary }}"
arc_colour = "{{ outline }}"
gpu_colours = ["{{ primary }}", "{{ secondary }}", "{{ tertiary }}"]

[styles.network]
rx_colour = "{{ secondary }}"
tx_colour = "{{ tertiary }}"
rx_total_colour = "{{ primary }}"
tx_total_colour = "{{ outline }}"

[styles.battery]
high_battery_colour = "{{ secondary }}"
medium_battery_colour = "{{ tertiary }}"
low_battery_colour = "{{ error }}"

[styles.temp_graph]
temp_graph_colour_styles = ["{{ tertiary }}", "{{ primary }}", "{{ error }}"]
