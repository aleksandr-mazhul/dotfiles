# Generated by theme-ssot — powerline: path · branch · time / ❯
# Chrome: highlight (path) · panel (branch) · muted (time)

format = """
$directory$git_branch$time
$character"""

# Blank line after command output; breathing room to ❯ via kitty adjust_line_height
add_newline = true

[directory]
style = "fg:{{ chrome_highlight_fg }} bg:{{ chrome_highlight_bg }}"
format = "[](fg:{{ chrome_highlight_bg }})[ $path ]($style)[](fg:{{ chrome_highlight_bg }} bg:{{ chrome_panel_bg }})"
truncation_length = 0
truncate_to_repo = false
fish_style_pwd_dir_length = 0
home_symbol = "~"
read_only = " 󰌾"

[git_branch]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $branch ]($style)"
symbol = ""

[time]
disabled = false
style = "fg:{{ chrome_muted_fg }} bg:{{ chrome_muted_bg }}"
format = "[](fg:{{ chrome_panel_bg }} bg:{{ chrome_muted_bg }})[ $time ]($style)[](fg:{{ chrome_muted_bg }})"
time_format = "%H:%M"

[character]
success_symbol = "[❯](bold {{ chrome_highlight_bg }})"
error_symbol = "[❯](bold {{ error }})"
vimcmd_symbol = "[❮](bold {{ chrome_panel_fg }})"
