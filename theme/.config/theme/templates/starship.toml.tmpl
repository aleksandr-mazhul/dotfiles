# Generated by theme-ssot — powerline: path · branch · env · time / ❯
# Chrome: highlight (path) · panel (branch + env) · muted (time)
#
# env = what your commands will actually hit right now, in three groups:
#   active env  — shown while switched on, wherever you are (venv, conda, direnv, nix, container)
#   toolchain   — shown only inside a project (marker files), with the version that will run
#   infra       — shown only when pointed somewhere non-default (docker/kube/tf/aws)
# Every env segment shares the branch panel bg, so the powerline separators
# stay correct no matter which segments are visible.

format = """
$directory$git_branch\
$container$nix_shell$direnv$python$conda\
$nodejs$bun$deno$rust$golang$java$ruby$lua$c\
$docker_context$kubernetes$terraform$aws\
$time
$character"""

# Blank line after command output; breathing room to ❯ via kitty adjust_line_height
add_newline = true
# java/ruby answer --version slowly on a cold start
command_timeout = 1000

[directory]
style = "fg:{{ chrome_highlight_fg }} bg:{{ chrome_highlight_bg }}"
format = "[](fg:{{ chrome_highlight_bg }})[ $path ]($style)[](fg:{{ chrome_highlight_bg }} bg:{{ chrome_panel_bg }})"
truncation_length = 0
truncate_to_repo = false
fish_style_pwd_dir_length = 0
home_symbol = "~"
read_only = " 󰌾"

[git_branch]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $branch ]($style)"
symbol = ""

# ── active env ───────────────────────────────────────────────────────────────

[container]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$name ]($style)"
symbol = " "

[nix_shell]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$state ]($style)"
symbol = " "
impure_msg = ""
pure_msg = "pure"

# .envrc present: show whether it is loaded/allowed, so a blocked .envrc is visible
[direnv]
disabled = false
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$loaded$allowed ]($style)"
symbol = " "
loaded_msg = ""
unloaded_msg = "off"
allowed_msg = ""
not_allowed_msg = " !allow"
denied_msg = " denied"

# venv is the point: it names where `pip install` lands. In a Python project
# without a venv only the interpreter version shows — that absence is the hint.
[python]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = '[ ${symbol}${version}( $virtualenv) ]($style)'
version_format = "${major}.${minor}"
symbol = " "
detect_extensions = []
detect_files = ["pyproject.toml", "requirements.txt", "setup.py", "Pipfile", ".python-version", "uv.lock"]
detect_folders = []

[conda]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$environment ]($style)"
symbol = " "
ignore_base = true

# ── toolchain (project marker files only) ────────────────────────────────────

[nodejs]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$version ]($style)"
version_format = "${major}.${minor}"
symbol = " "
detect_extensions = []

[bun]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$version ]($style)"
version_format = "${major}.${minor}"
symbol = " "

[deno]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$version ]($style)"
version_format = "${major}.${minor}"
symbol = " "

[rust]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$version ]($style)"
version_format = "${major}.${minor}"
symbol = " "
detect_extensions = []

# Arch's go reports "1.27.0-X:nodwarf5" — not semver, so ${major}/${minor} come out empty
[golang]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$version ]($style)"
version_format = "${raw}"
symbol = " "
detect_extensions = []

[java]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$version ]($style)"
version_format = "${major}"
symbol = " "
detect_extensions = []

[ruby]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$version ]($style)"
version_format = "${major}.${minor}"
symbol = " "
detect_extensions = []

# Not on *.lua / lua/ — every nvim config would light up
[lua]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$version ]($style)"
version_format = "${major}.${minor}"
symbol = " "
detect_extensions = ["rockspec"]
detect_files = [".lua-version"]
detect_folders = []

[c]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$name $version ]($style)"
version_format = "${major}"
symbol = " "
detect_extensions = []
detect_files = ["CMakeLists.txt", "meson.build", "Makefile", "configure.ac"]

# ── infra (only when pointed somewhere non-default) ──────────────────────────

[docker_context]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$context ]($style)"
symbol = " "
only_with_files = false

[kubernetes]
disabled = false
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$context( $namespace) ]($style)"
symbol = "󱃾 "
detect_files = ["Chart.yaml", "helmfile.yaml", "kustomization.yaml", "skaffold.yaml", "Tiltfile"]
detect_folders = ["k8s", "manifests", "charts"]
detect_env_vars = ["KUBECONFIG"]

[terraform]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$workspace ]($style)"
symbol = "󱁢 "

[aws]
style = "fg:{{ chrome_panel_fg }} bg:{{ chrome_panel_bg }}"
format = "[ $symbol$profile( $region) ]($style)"
symbol = " "

[time]
disabled = false
style = "fg:{{ chrome_muted_fg }} bg:{{ chrome_muted_bg }}"
format = "[](fg:{{ chrome_panel_bg }} bg:{{ chrome_muted_bg }})[ $time ]($style)[](fg:{{ chrome_muted_bg }})"
time_format = "%H:%M"

[character]
success_symbol = "[❯](bold {{ chrome_highlight_bg }})"
error_symbol = "[❯](bold {{ error }})"
vimcmd_symbol = "[❮](bold {{ chrome_panel_fg }})"
