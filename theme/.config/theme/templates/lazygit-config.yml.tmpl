# Generated by theme-ssot — do not edit by hand
# Tuned for readable contrast on translucent Kitty + sand/SSOT accents.
gui:
  nerdFontsVersion: "3"
  border: rounded
  showBottomLine: true
  showCommandLog: false
  theme:
    activeBorderColor:
      - "{{ primary }}"
      - bold
    inactiveBorderColor:
      - "{{ outline }}"
    searchingActiveBorderColor:
      - "{{ tertiary }}"
      - bold
    optionsTextColor:
      - "{{ primary }}"
    selectedLineBgColor:
      - "{{ primary_container }}"
    inactiveViewSelectedLineBgColor:
      - "{{ surface_container_high }}"
    cherryPickedCommitFgColor:
      - "{{ on_primary }}"
    cherryPickedCommitBgColor:
      - "{{ primary }}"
    markedBaseCommitFgColor:
      - "{{ on_primary }}"
    markedBaseCommitBgColor:
      - "{{ tertiary }}"
    unstagedChangesColor:
      - "{{ error }}"
    defaultFgColor:
      - "{{ on_surface }}"

# Commit / branch graph in the Commits panel
git:
  log:
    # always | when-maximised | never
    showGraph: always
    # true = git log --all (all branches in one graph)
    showWholeGraph: true
