/* Generated by theme-ssot — do not edit by hand */
window {
  background-color: {{ surface }};
  color: {{ on_surface }};
  border: 1px solid {{ outline }};
}
#input {
  background-color: {{ surface_container }};
  color: {{ on_surface }};
  border: 1px solid {{ outline }};
}
#inner-box, #outer-box, #scroll {
  background-color: {{ surface }};
}
#entry {
  background-color: transparent;
  color: {{ on_surface }};
}
#entry:selected {
  background-color: {{ primary }};
  color: {{ on_primary }};
}
#text {
  color: {{ on_surface }};
}
#entry:selected #text {
  color: {{ on_primary }};
}
