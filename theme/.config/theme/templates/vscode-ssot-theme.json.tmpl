    "breadcrumb.foreground": "#8a8a8a",
    "breadcrumb.focusForeground": "#f0f0f0",
    "breadcrumb.activeSelectionForeground": "#f0f0f0",

    "minimap.background": "{{ background }}",
    "minimapSlider.background": "#ffffff24"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "{{ on_surface_variant }}", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "{{ secondary }}" }
    },
    {
      "scope": ["constant", "constant.numeric", "constant.language", "variable.other.constant"],
      "settings": { "foreground": "{{ primary }}" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "{{ primary }}" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "{{ tertiary }}" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "{{ outline }}" }
    },
    {
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": { "foreground": "{{ on_surface }}" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "{{ primary }}" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "{{ secondary }}" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "{{ primary }}", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "{{ secondary }}" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{ error }}" }
    }
  ],
  "semanticTokenColors": {
    "function": "{{ tertiary }}",
    "method": "{{ tertiary }}",
    "keyword": "{{ primary }}",
    "string": "{{ secondary }}",
    "number": "{{ primary }}",
    "type": "{{ outline }}",
    "class": "{{ outline }}",
    "comment": "{{ on_surface_variant }}",
    "variable": "{{ on_surface }}",
    "parameter": "{{ on_surface }}",
    "property": "{{ secondary }}"
  }
}
