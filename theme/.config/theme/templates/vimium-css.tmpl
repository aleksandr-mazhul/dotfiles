/* Generated by theme-ssot — do not edit by hand */
:root {
  --vimium-accent: {{ primary }};
  --vimium-accent-fg: {{ on_primary }};
  --vimium-secondary: {{ secondary }};
  --vimium-tertiary: {{ tertiary }};
  --vimium-outline: {{ outline }};
  --vimium-text: {{ on_surface }};
  --vimium-muted: {{ on_surface_variant }};
  --vimium-surface2: {{ surface_variant }};
  --vimium-surface1: {{ surface_container_high }};
  --vimium-surface0: {{ surface_container }};
  --vimium-base: {{ background }};
  --vimium-mantle: {{ surface }};

  --vimium-foreground-text-color: {{ on_surface }};
  --vimium-background-text-color: {{ on_surface }};
  --vimium-foreground-color: {{ surface }};
}

/* Hints: hardcoded hex (no var()) so defaults cannot win if :root fails */
div > .vimiumHintMarker,
div.vimiumHintMarker,
div.internal-vimium-hint-marker {
  background: {{ primary }} !important;
  background-image: none !important;
  border: 1px solid {{ surface }} !important;
  box-shadow: none !important;
  padding: 3px 4px !important;
}

div > .vimiumHintMarker span,
div.vimiumHintMarker span,
div.internal-vimium-hint-marker span {
  color: {{ on_primary }} !important;
  font-weight: bold !important;
  font-size: 12px !important;
  text-shadow: none !important;
}

div > .vimiumHintMarker > .matchingCharacter,
div.vimiumHintMarker > .matchingCharacter,
div.internal-vimium-hint-marker > .matchingCharacter {
  color: {{ surface_variant }} !important;
}

/* vomnibar */
#vomnibar {
  background: {{ background }} !important;
  border: 2px solid {{ outline }} !important;
}

#vomnibar input,
#vomnibar #vomnibar-search-area,
#vomnibar ul {
  color: {{ on_surface }} !important;
  background: {{ background }} !important;
  border: none !important;
  box-shadow: none !important;
}

#vomnibar li {
  border-bottom: 1px solid {{ surface_container }} !important;
}

#vomnibar li .source {
  color: {{ tertiary }} !important;
}

#vomnibar li em,
#vomnibar li .title,
#vomnibar li .title .match,
#vomnibar li .match {
  color: {{ primary }} !important;
  font-weight: bold !important;
}

#vomnibar li .url {
  color: {{ secondary }} !important;
}

#vomnibar li.selected {
  background-color: {{ surface_container }} !important;
}

/* hud */
div#hud-container {
  background: {{ background }} !important;
  border: 1px solid {{ on_surface }} !important;
  box-shadow: none !important;
}

div#hud-container span#hud-find-input,
div#hud-container div#hud {
  color: {{ on_surface }} !important;
}

div#hud-container .hud-find,
div#hud-container #search-area {
  background-color: {{ background }} !important;
}

::selection {
  background-color: {{ tertiary }} !important;
  color: {{ on_primary }} !important;
}
