// Generated by theme-ssot — do not edit by hand
//
// zellij 0.42+ component theme. The old fg/bg/ANSI palette form gave
// list_selected the plain background and list_unselected chrome_muted_bg,
// two near-identical darks, so the session-manager's arrow-key selection was
// invisible. Selected rows/cells now sit on primary.
// Otherwise this mirrors zellij's own palette -> component mapping.
// Pane frames mirror tmux's pane-border-active/inactive: frame_selected =
// primary (focused pane), frame_unselected = surface_variant (the rest),
// frame_highlight = tertiary (while a mode like TMUX/SCROLL is active).
themes {
    ssot {
        text_unselected {
            base "{{ outline }}"
            background "{{ chrome_muted_bg }}"
            emphasis_0 "{{ tertiary }}"
            emphasis_1 "{{ secondary }}"
            emphasis_2 "{{ primary }}"
            emphasis_3 "{{ primary_container }}"
        }
        text_selected {
            base "{{ outline }}"
            background "{{ background }}"
            emphasis_0 "{{ tertiary }}"
            emphasis_1 "{{ secondary }}"
            emphasis_2 "{{ primary }}"
            emphasis_3 "{{ primary_container }}"
        }
        ribbon_unselected {
            base "{{ chrome_muted_bg }}"
            background "{{ outline }}"
            emphasis_0 "{{ error }}"
            emphasis_1 "{{ on_surface }}"
            emphasis_2 "{{ chrome_highlight_bg }}"
            emphasis_3 "{{ primary_container }}"
        }
        ribbon_selected {
            base "{{ chrome_muted_bg }}"
            background "{{ primary }}"
            emphasis_0 "{{ error }}"
            emphasis_1 "{{ tertiary }}"
            emphasis_2 "{{ primary_container }}"
            emphasis_3 "{{ chrome_highlight_bg }}"
        }
        table_title {
            base "{{ primary }}"
            emphasis_0 "{{ tertiary }}"
            emphasis_1 "{{ secondary }}"
            emphasis_2 "{{ primary }}"
            emphasis_3 "{{ primary_container }}"
        }
        table_cell_unselected {
            base "{{ outline }}"
            background "{{ chrome_muted_bg }}"
            emphasis_0 "{{ tertiary }}"
            emphasis_1 "{{ secondary }}"
            emphasis_2 "{{ primary }}"
            emphasis_3 "{{ primary_container }}"
        }
        table_cell_selected {
            base "{{ on_primary }}"
            background "{{ primary }}"
            emphasis_0 "{{ primary_container }}"
            emphasis_1 "{{ primary_container }}"
            emphasis_2 "{{ primary_container }}"
            emphasis_3 "{{ primary_container }}"
        }
        list_unselected {
            base "{{ outline }}"
            background "{{ chrome_muted_bg }}"
            emphasis_0 "{{ tertiary }}"
            emphasis_1 "{{ secondary }}"
            emphasis_2 "{{ primary }}"
            emphasis_3 "{{ primary_container }}"
        }
        list_selected {
            base "{{ on_primary }}"
            background "{{ primary }}"
            emphasis_0 "{{ primary_container }}"
            emphasis_1 "{{ primary_container }}"
            emphasis_2 "{{ primary_container }}"
            emphasis_3 "{{ primary_container }}"
        }
        frame_selected {
            base "{{ primary }}"
            emphasis_0 "{{ tertiary }}"
            emphasis_1 "{{ secondary }}"
            emphasis_2 "{{ primary_container }}"
            emphasis_3 "{{ outline }}"
        }
        frame_unselected {
            base "{{ surface_variant }}"
            emphasis_0 "{{ tertiary }}"
            emphasis_1 "{{ secondary }}"
            emphasis_2 "{{ primary }}"
            emphasis_3 "{{ outline }}"
        }
        frame_highlight {
            base "{{ tertiary }}"
            emphasis_0 "{{ primary_container }}"
            emphasis_1 "{{ tertiary }}"
            emphasis_2 "{{ tertiary }}"
            emphasis_3 "{{ tertiary }}"
        }
        exit_code_success {
            base "{{ primary }}"
            emphasis_0 "{{ secondary }}"
            emphasis_1 "{{ on_surface }}"
            emphasis_2 "{{ primary_container }}"
            emphasis_3 "{{ chrome_highlight_bg }}"
        }
        exit_code_error {
            base "{{ error }}"
            emphasis_0 "{{ tertiary }}"
            emphasis_1 "{{ error }}"
            emphasis_2 "{{ error }}"
            emphasis_3 "{{ error }}"
        }
    }
}
