#!/usr/bin/env bash
# Generated by theme-ssot — do not edit by hand
#
# Chrome roles (SSOT):
#   highlight = primary bg + on_primary fg  (path / session / active window)
#   panel     = surface_container_high + secondary (branch / inactive name)
#   muted     = surface_container + tertiary (time / inactive index)
#
declare -gA THEME_COLORS=(
    [background]="{{ background }}"
    [statusbar-bg]="{{ chrome_muted_bg }}"
    [statusbar-fg]="{{ chrome_panel_fg }}"
    [session-bg]="{{ chrome_highlight_bg }}"
    [session-fg]="{{ chrome_highlight_fg }}"
    [session-prefix-bg]="{{ secondary }}"
    [session-copy-bg]="{{ tertiary }}"
    [session-search-bg]="{{ chrome_highlight_bg }}"
    [session-command-bg]="{{ primary_container }}"
    [window-active-base]="{{ chrome_highlight_bg }}"
    [window-active-style]="bold"
    [window-inactive-base]="{{ chrome_panel_bg }}"
    [window-inactive-style]="none"
    [window-activity-style]="italics"
    [window-bell-style]="bold"
    [window-zoomed-bg]="{{ tertiary }}"
    [pane-border-active]="{{ chrome_highlight_bg }}"
    [pane-border-inactive]="{{ surface_variant }}"
    [ok-base]="{{ chrome_panel_bg }}"
    [good-base]="{{ tertiary }}"
    [info-base]="{{ secondary }}"
    [warning-base]="{{ chrome_highlight_bg }}"
    [error-base]="{{ error }}"
    [disabled-base]="{{ surface_variant }}"
    [message-bg]="{{ chrome_muted_bg }}"
    [message-fg]="{{ chrome_panel_fg }}"
    [popup-bg]="{{ chrome_muted_bg }}"
    [popup-fg]="{{ chrome_panel_fg }}"
    [popup-border]="{{ chrome_highlight_bg }}"
    [menu-bg]="{{ chrome_muted_bg }}"
    [menu-fg]="{{ chrome_panel_fg }}"
    [menu-selected-bg]="{{ chrome_highlight_bg }}"
    [menu-selected-fg]="{{ chrome_highlight_fg }}"
    [menu-border]="{{ chrome_highlight_bg }}"
    # Explicit chrome keys (read by SSOT window-color override below)
    [chrome-highlight-bg]="{{ chrome_highlight_bg }}"
    [chrome-highlight-fg]="{{ chrome_highlight_fg }}"
    [chrome-panel-bg]="{{ chrome_panel_bg }}"
    [chrome-panel-fg]="{{ chrome_panel_fg }}"
    [chrome-muted-bg]="{{ chrome_muted_bg }}"
    [chrome-muted-fg]="{{ chrome_muted_fg }}"
)

# Pin PowerKit index strips to SSOT muted/highlight (not auto +20% -lighter).
_ssot_pin_powerkit_chrome() {
    [[ -n "${THEME_COLORS[chrome-highlight-bg]:-}" ]] &&
        _COLOR_VARIANTS["window-active-base-lighter"]="${THEME_COLORS[chrome-highlight-bg]}"
    [[ -n "${THEME_COLORS[chrome-muted-bg]:-}" ]] &&
        _COLOR_VARIANTS["window-inactive-base-lighter"]="${THEME_COLORS[chrome-muted-bg]}"
}

# Split index vs name colors (PowerKit normally forces the same fg for both).
# Active:  index+name on highlight (peach) with dark text
# Inactive: index = muted fg on muted bg; name = panel fg on panel bg
_ssot_windows_get_colors() {
    local state="$1"
    local index_bg index_fg content_bg content_fg style

    if [[ "$state" == "active" ]]; then
        index_bg=$(resolve_color "chrome-highlight-bg")
        index_fg=$(resolve_color "chrome-highlight-fg")
        content_bg=$(resolve_color "window-active-base")
        content_fg=$(resolve_color "chrome-highlight-fg")
    else
        index_bg=$(resolve_color "chrome-muted-bg")
        index_fg=$(resolve_color "chrome-muted-fg")
        content_bg=$(resolve_color "window-inactive-base")
        content_fg=$(resolve_color "chrome-panel-fg")
    fi
    style=$(get_window_style "$state")
    printf '%s %s %s %s %s' "$index_bg" "$index_fg" "$content_bg" "$content_fg" "$style"
}

if declare -F _windows_get_colors >/dev/null 2>&1; then
    _windows_get_colors() { _ssot_windows_get_colors "$@"; }
fi

if declare -F generate_color_variants >/dev/null 2>&1 && [[ -z "${_SSOT_GENERATE_WRAPPED:-}" ]]; then
    _SSOT_GENERATE_WRAPPED=1
    eval "_ssot_orig_generate_color_variants() $(declare -f generate_color_variants | tail -n +2)"
    generate_color_variants() {
        _ssot_orig_generate_color_variants "$@"
        _ssot_pin_powerkit_chrome
    }
fi

# When theme colors load from cache, re-pin strips + reinstall window override.
if declare -F deserialize_theme_colors >/dev/null 2>&1 && [[ -z "${_SSOT_DESER_WRAPPED:-}" ]]; then
    _SSOT_DESER_WRAPPED=1
    eval "_ssot_orig_deserialize_theme_colors() $(declare -f deserialize_theme_colors | tail -n +2)"
    deserialize_theme_colors() {
        _ssot_orig_deserialize_theme_colors "$@"
        _ssot_pin_powerkit_chrome
        if declare -F _windows_get_colors >/dev/null 2>&1; then
            _windows_get_colors() { _ssot_windows_get_colors "$@"; }
        fi
    }
fi

_ssot_pin_powerkit_chrome
