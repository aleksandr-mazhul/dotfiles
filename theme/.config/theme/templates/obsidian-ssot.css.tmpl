/* Generated by theme-ssot — do not edit by hand */
.theme-dark, .theme-light {
  --background-primary: {{ background }};
  --background-primary-alt: {{ surface }};
  --background-secondary: {{ surface }};
  --background-secondary-alt: {{ surface_container }};
  --background-modifier-border: {{ outline }}55;
  --background-modifier-hover: {{ surface_container_high }};
  --background-modifier-active-hover: {{ primary_container }};
  --background-modifier-form-field: {{ surface_container }};
  --text-normal: {{ on_surface }};
  --text-muted: {{ on_surface_variant }};
  --text-faint: {{ outline }};
  --text-accent: {{ primary }};
  --text-accent-hover: {{ secondary }};
  --text-on-accent: {{ on_primary }};
  --text-error: {{ error }};
  --text-selection: {{ primary }}44;
  --interactive-normal: {{ surface_container }};
  --interactive-hover: {{ surface_container_high }};
  --interactive-accent: {{ primary }};
  --interactive-accent-hover: {{ secondary }};
  --titlebar-background: {{ background }};
  --titlebar-background-focused: {{ background }};
  --tab-container-background: {{ background }};
  --tab-active-background: {{ surface }};
  --tab-inactive-background: {{ background }};
  --nav-item-background-active: {{ primary_container }};
  --nav-item-color-active: {{ on_surface }};
  --ribbon-background: {{ background }};
  --canvas-background: {{ background }};
  --divider-color: {{ surface_container }};
  --scrollbar-bg: {{ surface_variant }}55;
  --accent-h: 28;
  --color-accent: {{ primary }};
  --color-accent-1: {{ primary }};
  --color-accent-2: {{ secondary }};
}

body {
  --accent-color: {{ primary }};
}
