# Generated by theme-ssot — do not edit by hand
# Colors: #RRGGBB from ~/.config/theme/palette.toml

# Transparent — kitty/terminal already carries the wallpaper SSOT bg
theme[main_bg]=""

theme[main_fg]="{{ on_surface }}"
theme[title]="{{ on_surface }}"
theme[hi_fg]="{{ primary }}"
theme[selected_bg]="{{ surface_container_high }}"
theme[selected_fg]="{{ primary }}"
theme[inactive_fg]="{{ surface_variant }}"
theme[graph_text]="{{ on_surface_variant }}"
theme[meter_bg]="{{ surface_container }}"
theme[proc_misc]="{{ tertiary }}"

# Box outlines — one accent family each, not rainbow noise
theme[cpu_box]="{{ primary }}"
theme[mem_box]="{{ secondary }}"
theme[net_box]="{{ tertiary }}"
theme[proc_box]="{{ outline }}"
theme[div_line]="{{ surface_variant }}"

# Temperature: cool → warn → hot
theme[temp_start]="{{ tertiary }}"
theme[temp_mid]="{{ primary }}"
theme[temp_end]="{{ error }}"

# CPU load
theme[cpu_start]="{{ tertiary }}"
theme[cpu_mid]="{{ primary }}"
theme[cpu_end]="{{ error }}"

# Memory meters
theme[free_start]="{{ surface_container }}"
theme[free_mid]="{{ tertiary }}"
theme[free_end]="{{ secondary }}"

theme[cached_start]="{{ surface_container_high }}"
theme[cached_mid]="{{ secondary }}"
theme[cached_end]="{{ outline }}"

theme[available_start]="{{ surface_container }}"
theme[available_mid]="{{ primary }}"
theme[available_end]="{{ primary }}"

theme[used_start]="{{ primary }}"
theme[used_mid]="{{ primary }}"
theme[used_end]="{{ error }}"

# Network
theme[download_start]="{{ tertiary }}"
theme[download_mid]="{{ secondary }}"
theme[download_end]="{{ primary }}"

theme[upload_start]="{{ outline }}"
theme[upload_mid]="{{ secondary }}"
theme[upload_end]="{{ primary }}"

# Process list
theme[process_start]="{{ tertiary }}"
theme[process_mid]="{{ primary }}"
theme[process_end]="{{ surface_variant }}"
