/* Generated by theme-ssot — do not edit by hand */
@define-color theme_bg_color {{ background }};
@define-color theme_fg_color {{ on_surface }};
@define-color theme_selected_bg_color {{ primary }};
@define-color theme_selected_fg_color {{ on_primary }};
@define-color theme_unfocused_selected_bg_color {{ secondary }};
@define-color theme_unfocused_selected_fg_color {{ on_primary }};
@define-color accents_primary {{ primary }};
@define-color accents_secondary {{ secondary }};
@define-color warning_color {{ tertiary }};
@define-color error_color {{ error }};
@define-color card_bg_color {{ surface_container }};
@define-color view_bg_color {{ surface }};
@define-color window_bg_color {{ background }};
@define-color window_fg_color {{ on_surface }};

/* Main chrome — include .background so libadwaita sidebars stay dark */
window:not(.popup):not(.tooltip), dialog, messagedialog, .background {
  background-color: @window_bg_color;
  color: @window_fg_color;
}

/* Popup WINDOW shell only: transparent so we don't get a black plate behind
   rounded menus. Actual menu/popover body is painted below. */
window.popup, window.tooltip {
  background-color: transparent;
  background-image: none;
  box-shadow: none;
}

popover > contents,
popover.menu contents,
menu,
.menu,
.csd.popup menuitem,
tooltip > contents {
  background-color: @card_bg_color;
  color: @theme_fg_color;
  border-radius: 12px;
  border: 1px solid alpha({{ outline }}, 0.35);
}

popover > contents modelbutton:hover,
popover > contents modelbutton:selected,
menu menuitem:hover,
.menu menuitem:hover {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
  border-radius: 8px;
}

/* Nautilus / Adw navigation sidebar */
.sidebar,
.navigation-sidebar,
list.navigation-sidebar,
.nautilus-window .sidebar,
flap > .sidebar {
  background-color: @view_bg_color;
  color: @theme_fg_color;
}

.sidebar label,
.sidebar .title,
.navigation-sidebar label,
.navigation-sidebar .title,
list.navigation-sidebar label,
list.navigation-sidebar row,
list.navigation-sidebar row label {
  color: @theme_fg_color;
  opacity: 1;
}

list.navigation-sidebar row:selected,
list.navigation-sidebar row:selected label,
.navigation-sidebar row:selected,
.navigation-sidebar row:selected label {
  color: @theme_selected_fg_color;
}

entry, spinbutton, search, textview {
  background-color: @card_bg_color;
  color: @theme_fg_color;
  border-color: {{ outline }};
  caret-color: {{ primary }};
}

button {
  background-image: none;
  background-color: @card_bg_color;
  color: @theme_fg_color;
  border-color: {{ outline }};
}

button:hover, button.suggested-action, button.default {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}

selection, *:selected {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}

headerbar, notebook > header, tab {
  background-color: @view_bg_color;
  color: @theme_fg_color;
}

tab:checked, .titlebar {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}
