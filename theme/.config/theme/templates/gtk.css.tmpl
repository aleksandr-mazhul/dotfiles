/* Generated by theme-ssot — do not edit by hand */

/* libadwaita named colors — GNOME Files (Nautilus) and every Adw app */
@define-color accent_color {{ primary }};
@define-color accent_bg_color {{ primary }};
@define-color accent_fg_color {{ on_primary }};
@define-color destructive_color {{ error }};
@define-color destructive_bg_color {{ error }};
@define-color destructive_fg_color {{ on_primary }};
@define-color success_color {{ secondary }};
@define-color success_bg_color {{ secondary }};
@define-color success_fg_color {{ on_primary }};
@define-color warning_color {{ tertiary }};
@define-color warning_bg_color {{ tertiary }};
@define-color warning_fg_color {{ on_primary }};
@define-color error_color {{ error }};
@define-color error_bg_color {{ error }};
@define-color error_fg_color {{ on_primary }};
@define-color window_bg_color {{ background }};
@define-color window_fg_color {{ on_surface }};
@define-color view_bg_color {{ surface }};
@define-color view_fg_color {{ on_surface }};
@define-color headerbar_bg_color {{ surface }};
@define-color headerbar_fg_color {{ on_surface }};
@define-color headerbar_border_color {{ outline }};
@define-color headerbar_backdrop_color {{ background }};
@define-color headerbar_shade_color {{ background }};
@define-color sidebar_bg_color {{ surface }};
@define-color sidebar_fg_color {{ on_surface }};
@define-color sidebar_backdrop_color {{ background }};
@define-color sidebar_shade_color {{ background }};
@define-color sidebar_border_color {{ outline }};
@define-color secondary_sidebar_bg_color {{ surface_container }};
@define-color secondary_sidebar_fg_color {{ on_surface }};
@define-color card_bg_color {{ surface_container }};
@define-color card_fg_color {{ on_surface }};
@define-color dialog_bg_color {{ surface_container }};
@define-color dialog_fg_color {{ on_surface }};
@define-color popover_bg_color {{ surface_container_high }};
@define-color popover_fg_color {{ on_surface }};
@define-color thumbnail_bg_color {{ surface_container }};
@define-color shade_color {{ background }};
@define-color scrollbar_outline_color {{ outline }};

/* GTK 3 aliases */
@define-color theme_bg_color {{ background }};
@define-color theme_fg_color {{ on_surface }};
@define-color theme_selected_bg_color {{ primary }};
@define-color theme_selected_fg_color {{ on_primary }};
@define-color theme_unfocused_selected_bg_color {{ secondary }};
@define-color theme_unfocused_selected_fg_color {{ on_primary }};
@define-color accents_primary {{ primary }};
@define-color accents_secondary {{ secondary }};

/* Main chrome — include .background so libadwaita sidebars stay dark */
window:not(.popup):not(.tooltip), dialog, messagedialog, .background {
  background-color: @window_bg_color;
  color: @window_fg_color;
}

/* Popup WINDOW shell only: transparent so we don't get a black plate behind
   rounded menus. Actual menu/popover body is painted below. */
window.popup, window.tooltip {
  background-color: transparent;
  background-image: none;
  box-shadow: none;
}

popover > contents,
popover.menu contents,
menu,
.menu,
.csd.popup menuitem,
tooltip > contents {
  background-color: @card_bg_color;
  color: @theme_fg_color;
  border-radius: 12px;
  border: 1px solid alpha({{ outline }}, 0.35);
}

popover > contents modelbutton:hover,
popover > contents modelbutton:selected,
menu menuitem:hover,
.menu menuitem:hover {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
  border-radius: 8px;
}

.nautilus-window,
.nautilus-window .background,
.nautilus-list-view,
.nautilus-grid-view,
.nautilus-canvas-view {
  background-color: @view_bg_color;
  color: @view_fg_color;
}

.nautilus-window .sidebar-pane,
.nautilus-window toolbarview.sidebar-pane {
  background-color: @sidebar_bg_color;
  color: @sidebar_fg_color;
}
.sidebar,
.navigation-sidebar,
list.navigation-sidebar,
.nautilus-window .sidebar,
flap > .sidebar {
  background-color: @view_bg_color;
  color: @theme_fg_color;
}

.sidebar label,
.sidebar .title,
.navigation-sidebar label,
.navigation-sidebar .title,
list.navigation-sidebar label,
list.navigation-sidebar row,
list.navigation-sidebar row label {
  color: @theme_fg_color;
  opacity: 1;
}

list.navigation-sidebar row:selected,
list.navigation-sidebar row:selected label,
.navigation-sidebar row:selected,
.navigation-sidebar row:selected label {
  color: @theme_selected_fg_color;
}

entry, spinbutton, search, textview {
  background-color: @card_bg_color;
  color: @theme_fg_color;
  border-color: {{ outline }};
  caret-color: {{ primary }};
}

button {
  background-image: none;
  background-color: @card_bg_color;
  color: @theme_fg_color;
  border-color: {{ outline }};
}

button:hover, button.suggested-action, button.default {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}

selection, *:selected {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}

headerbar, notebook > header, tab {
  background-color: @view_bg_color;
  color: @theme_fg_color;
}

tab:checked, .titlebar {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}
