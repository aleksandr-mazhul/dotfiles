# Python bytecode
**/__pycache__/
*.py[cod]

# Recreated by apply-wallpaper-theme
hypr/.config/hypr/lock-wallpaper

# Hyprland may recreate a stub .conf when on Lua; ignore it (use hyprland.lua)
hypr/.config/hypr/hyprland.conf

# Third-party plugin sources (built binary lives under ~/.local/lib/hypr)
hypr/.config/hypr/vendor/
