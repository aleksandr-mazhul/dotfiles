# Python bytecode
**/__pycache__/
*.py[cod]

# Recreated by apply-wallpaper-theme
hypr/.config/hypr/lock-wallpaper

# Hyprland may recreate a stub .conf when on Lua; ignore it (use hyprland.lua)
hypr/.config/hypr/hyprland.conf

# Third-party plugin sources (built binary lives under ~/.local/lib/hypr)
hypr/.config/hypr/vendor/

# Scratch / logs / secrets
.cursor/
.tmp-*
nvim.log
obs/.config/obs-studio/logs/
obs/.config/obs-studio/.sentinel/
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
chromium-ffmpeg/
*.bak
obs/.config/obs-studio/plugin_config/obs-websocket/config.json

# OBS profiler dumps
obs/.config/obs-studio/profiler_data/

# Claude Code local (per-machine) settings
.claude/
