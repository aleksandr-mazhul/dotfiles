{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "right": 2
    },
    "color": {
      "1": "yellow",
      "2": "white"
    }
  },
  "display": {
    "brightColor": true,
    "separator": "  ",
    "color": {
      "keys": "yellow",
      "title": "magenta",
      "output": "default",
      "separator": "dim_white"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "shell",
    "de",
    "wm",
    "icons",
    "terminal",
    "cpu",
    "memory",
    "break",
    "colors"
  ]
}
