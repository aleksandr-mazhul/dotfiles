[Unit]
Description=Kanata keyboard remapper (user unit; needs input group in session)
Documentation=https://github.com/jtroo/kanata
After=graphical-session.target

[Service]
Type=simple
# --nodelay: skip 2s startup sleep so unlock repair / USB re-plug keeps HRM alive
ExecStart=/usr/bin/kanata --nodelay --cfg %h/.config/kanata/kanata.kbd
Restart=on-failure
RestartSec=1
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
