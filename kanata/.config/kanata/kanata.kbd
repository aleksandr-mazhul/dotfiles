;; Linux kanata config (Mac will use a separate file later, e.g. kanata.macos.kbd)
;;
;; Home row mods — finger-compatible with Mac Cmd muscle memory:
;;   Mac:   A=Ctrl  S=Opt   D=Cmd   F=Shift
;;   Linux: A=Super S=Alt   D=Ctrl  F=Shift
;; So ring finger (D) stays the "primary" mod: Cmd on Mac, Ctrl on Linux.
;;
;; Left:  A=Super  S=Alt  D=Ctrl  F=Shift
;; Right: J=Shift  K=Ctrl  L=Alt  ;=Super
;; Caps:  tap=Esc, hold=Ctrl
;;
;; Text navigation:
;;   Alt/Opt + ←/→           word (→ Ctrl+←/→ via defoverrides; works in Telegram/Qt)
;;   Ctrl/Cmd-finger + ←/→   line start/end
;;   Ctrl/Cmd-finger + ↑/↓   document start/end
;;   Ctrl+Alt + ←/→          passthrough (Zen workspace folders, etc.)
;;   + Shift                 selection
;;   Alt + Backspace/Delete  delete word
;;
;; Super+arrows stay free for Mission Control (GloView).
;;
;; Mouse tab buttons (firmware → Super+Shift+[ / ]):
;;   remapped here to Ctrl+Page_Up/Down for browsers & tabbed apps.
;;   kitty also binds Ctrl+Page_Up/Down → tmux prev/next window.
;;
;; Tip: disable HRM in Vial on this machine — let kanata own the holds.
;;
;; Text snippets (US layout): type /map → email. Shift+/ stays ?.

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  ;; HRM anti-roll: same finger sequence as Mac config (A S D F / J K L ;),
  ;; not remapped onto Linux Super-Alt-Ctrl-Shift key names.
  tap-hold-require-prior-idle 120
  ;; Overrides tap their output key instead of holding it for the whole chord.
  ;;
  ;; NOTE: this was added believing kanata caused the ^[[6~ flood. It did not —
  ;; measured, kanata emits exactly one pgdn press+release per activation and
  ;; never an autorepeat event. The flood came from Hyprland swallowing the key
  ;; release of a Lua `pass` bind (see hypr/binds.lua); fixed there.
  ;;
  ;; Kept because it still bounds a HELD keyboard chord (the mouse can't hold
  ;; one — its firmware emits a fixed ~4ms macro regardless).
  ;; Trade-off, and it applies to EVERY override in this file: holding Alt+←/→
  ;; no longer repeats word motion — one jump per press.
  override-release-on-activation yes
  ;; Exact kbd nodes only — name filters still match duplicate HID interfaces
  ;; (Ergohaven "… Keyboard", multiple Dragonfly nodes) and break Alt+arrows in Qt.
  ;; kanata watches /dev/input (inotify IN_CREATE), so a device listed here is
  ;; picked up on hotplug without a restart. A keyboard NOT listed still works
  ;; — it just bypasses kanata entirely (no HRM, no Caps->Esc, no /map).
  linux-dev (
    /dev/input/by-id/usb-Ergohaven_K:03_v3_v4_vial:f64c2b3c-event-kbd
    /dev/input/by-id/usb-Compx_VGN_Dragonfly_4K_Receiver-event-kbd
  )
)

(defvar
  tap-time  200
  hold-time 220
)

(defsrc
  caps
  a s d f
  j k l scln
  lctl rctl
  left right up down
  /
)

(defalias
  ;; Ctrl held → line / document edges (must be a layer, not overrides:
  ;; otherwise Alt→Ctrl+← would also become Home).
  ;; When Alt is also held, keep arrows so Ctrl+Alt+←/→ reach apps (Zen workspaces).
  ;; fork checks INPUT keys: HRM Alt is physical S/L, not only lalt/ralt.
  linebeg (fork (unmod (lctl rctl) home) left  (lalt ralt s l))
  lineend (fork (unmod (lctl rctl) end)  right (lalt ralt s l))
  docbeg  (unmod (lctl rctl) lctl home)
  docend  (unmod (lctl rctl) lctl end)

  plctl (multi lctl (layer-while-held mctl))
  prctl (multi rctl (layer-while-held mctl))

  caps (tap-hold $tap-time $hold-time esc @plctl (require-prior-idle 0))

  ;; home row mods: Super Alt Ctrl Shift (Linux)
  met  (tap-hold-release $tap-time $hold-time a lmet)
  alt  (tap-hold-release $tap-time $hold-time s lalt)
  ctl  (tap-hold-release $tap-time $hold-time d @plctl)
  sft  (tap-hold-release $tap-time $hold-time f lsft)

  rsft  (tap-hold-release $tap-time $hold-time j rsft)
  hrctl (tap-hold-release $tap-time $hold-time k @prctl)
  ralt  (tap-hold-release $tap-time $hold-time l ralt)
  rmet  (tap-hold-release $tap-time $hold-time scln rmet)

  ;; /map → email. Modifiers (incl. HRM) keep a normal / (? , Ctrl+/).
  slseq (switch
    (lsft rsft lctl rctl lmet rmet lalt ralt) / break
    () (macro (sequence 1200 visible-backspaced) 10 /) break
  )
)

(defvirtualkeys
  snip-map (macro m a p Digit0 Digit7 Digit1 Digit0 Digit2 Digit0 Digit0 Digit7 S-Digit2 g m a i l . c o m)
)
(defseq
  snip-map (/ m a p)
)

(deflayer base
  @caps
  @met @alt @ctl @sft
  @rsft @hrctl @ralt @rmet
  @plctl @prctl
  left right up down
  @slseq
)

(deflayer mctl
  _
  _ _ _ _
  _ _ _ _
  _ _
  @linebeg @lineend @docbeg @docend
  _
)

;; Alt/Opt word motion — global overrides (reliable in Telegram / Qt / GTK).
;; Do NOT override Ctrl+arrows here (those are line edges via mctl).
;; Exclude Ctrl so Ctrl+Alt+←/→ stays passthrough (Zen workspace folders).
(defoverridesv2
  (lalt left)  (lctl left)  (lctl rctl) ()
  (lalt right) (lctl right) (lctl rctl) ()
  (ralt left)  (lctl left)  (lctl rctl) ()
  (ralt right) (lctl right) (lctl rctl) ()

  (lsft lalt left)  (lsft lctl left)  (lctl rctl) ()
  (lsft lalt right) (lsft lctl right) (lctl rctl) ()
  (rsft lalt left)  (rsft lctl left)  (lctl rctl) ()
  (rsft lalt right) (rsft lctl right) (lctl rctl) ()
  (lsft ralt left)  (lsft lctl left)  (lctl rctl) ()
  (lsft ralt right) (lsft lctl right) (lctl rctl) ()
  (rsft ralt left)  (rsft lctl left)  (lctl rctl) ()
  (rsft ralt right) (rsft lctl right) (lctl rctl) ()

  (lalt bspc) (lctl bspc) (lctl rctl) ()
  (ralt bspc) (lctl bspc) (lctl rctl) ()
  (lalt del)  (lctl del)  (lctl rctl) ()
  (ralt del)  (lctl del)  (lctl rctl) ()

  ;; Mac-like tab switch (mouse / Super+Shift+[ ]) → native Linux tab keys.
  ;; The override puppeteers the mods: it releases the real Super/Shift, injects
  ;; lctl+pgup, then re-presses Shift. Excluding Ctrl keeps a real Ctrl out of
  ;; that window, where it could desync the bookkeeping and leave a mod stuck.
  ;; (Measured over a full session, every modifier's press/release count balances
  ;; exactly, so the desync is a hazard guarded against, not one observed.)
  (lsft lmet lbrc) (lctl pgup) (lctl rctl) ()
  (lsft lmet rbrc) (lctl pgdn) (lctl rctl) ()
  (rsft lmet lbrc) (lctl pgup) (lctl rctl) ()
  (rsft lmet rbrc) (lctl pgdn) (lctl rctl) ()
  (lsft rmet lbrc) (lctl pgup) (lctl rctl) ()
  (lsft rmet rbrc) (lctl pgdn) (lctl rctl) ()
  (rsft rmet lbrc) (lctl pgup) (lctl rctl) ()
  (rsft rmet rbrc) (lctl pgdn) (lctl rctl) ()
)
