// Generated by theme-ssot — do not edit by hand
//
// zellij 0.42+ component theme. The old fg/bg/ANSI palette form gave
// list_selected the plain background and list_unselected chrome_muted_bg,
// two near-identical darks, so the session-manager's arrow-key selection was
// invisible. Selected rows/cells now sit on primary.
// Otherwise this mirrors zellij's own palette -> component mapping.
// Pane frames mirror tmux's pane-border-active/inactive: frame_selected =
// primary (focused pane), frame_unselected = surface_variant (the rest),
// frame_highlight = tertiary (while a mode like TMUX/SCROLL is active).
themes {
    ssot {
        text_unselected {
            base "#c4a882"
            background "#343332"
            emphasis_0 "#cac993"
            emphasis_1 "#e5bfa9"
            emphasis_2 "#ffb688"
            emphasis_3 "#6e380f"
        }
        text_selected {
            base "#c4a882"
            background "#242423"
            emphasis_0 "#cac993"
            emphasis_1 "#e5bfa9"
            emphasis_2 "#ffb688"
            emphasis_3 "#6e380f"
        }
        ribbon_unselected {
            base "#343332"
            background "#c4a882"
            emphasis_0 "#ffb4ab"
            emphasis_1 "#ebe1d4"
            emphasis_2 "#ffb688"
            emphasis_3 "#6e380f"
        }
        ribbon_selected {
            base "#343332"
            background "#ffb688"
            emphasis_0 "#ffb4ab"
            emphasis_1 "#cac993"
            emphasis_2 "#6e380f"
            emphasis_3 "#ffb688"
        }
        table_title {
            base "#ffb688"
            emphasis_0 "#cac993"
            emphasis_1 "#e5bfa9"
            emphasis_2 "#ffb688"
            emphasis_3 "#6e380f"
        }
        table_cell_unselected {
            base "#c4a882"
            background "#343332"
            emphasis_0 "#cac993"
            emphasis_1 "#e5bfa9"
            emphasis_2 "#ffb688"
            emphasis_3 "#6e380f"
        }
        table_cell_selected {
            base "#1a1008"
            background "#ffb688"
            emphasis_0 "#6e380f"
            emphasis_1 "#6e380f"
            emphasis_2 "#6e380f"
            emphasis_3 "#6e380f"
        }
        list_unselected {
            base "#c4a882"
            background "#343332"
            emphasis_0 "#cac993"
            emphasis_1 "#e5bfa9"
            emphasis_2 "#ffb688"
            emphasis_3 "#6e380f"
        }
        list_selected {
            base "#1a1008"
            background "#ffb688"
            emphasis_0 "#6e380f"
            emphasis_1 "#6e380f"
            emphasis_2 "#6e380f"
            emphasis_3 "#6e380f"
        }
        frame_selected {
            base "#ffb688"
            emphasis_0 "#cac993"
            emphasis_1 "#e5bfa9"
            emphasis_2 "#6e380f"
            emphasis_3 "#c4a882"
        }
        frame_unselected {
            base "#5e5c5a"
            emphasis_0 "#cac993"
            emphasis_1 "#e5bfa9"
            emphasis_2 "#ffb688"
            emphasis_3 "#c4a882"
        }
        frame_highlight {
            base "#cac993"
            emphasis_0 "#6e380f"
            emphasis_1 "#cac993"
            emphasis_2 "#cac993"
            emphasis_3 "#cac993"
        }
        exit_code_success {
            base "#ffb688"
            emphasis_0 "#e5bfa9"
            emphasis_1 "#ebe1d4"
            emphasis_2 "#6e380f"
            emphasis_3 "#ffb688"
        }
        exit_code_error {
            base "#ffb4ab"
            emphasis_0 "#cac993"
            emphasis_1 "#ffb4ab"
            emphasis_2 "#ffb4ab"
            emphasis_3 "#ffb4ab"
        }
    }
}
