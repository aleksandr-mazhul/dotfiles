#!/usr/bin/env bash
# Telegram with 24-hour clocks (en_US system locale is 12-hour).
# Uses a user-local en_GB locale under ~/.locale — no root required.
set -euo pipefail

LOCALE_DIR="${HOME}/.locale"
LOCALE_NAME="en_GB.UTF-8"

if [[ ! -e "${LOCALE_DIR}/${LOCALE_NAME}/LC_TIME" ]]; then
  mkdir -p "${LOCALE_DIR}"
  localedef -i en_GB -f UTF-8 "${LOCALE_DIR}/${LOCALE_NAME}" >/dev/null 2>&1 || true
fi

export LOCPATH="${LOCALE_DIR}"
# Full en_GB for this process so LOCPATH does not break other LC_* lookups.
export LC_ALL="${LOCALE_NAME}"

# A tg:// or https link is an explicit click. Incoming notifications never
# re-run this launcher, so they must not move the workspace.
focus_telegram_link() {
  local arg has_url=0 addr=""
  for arg in "$@"; do
    case "$arg" in
      *://*) has_url=1 ;;
    esac
  done
  [[ "$has_url" -eq 1 ]] || return 0
  command -v hyprctl >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  addr="$(
    hyprctl -j clients 2>/dev/null | jq -r '
      [ .[]
        | select(.class == "org.telegram.desktop" or .class == "TelegramDesktop")
        | select(.mapped != false and .floating != true)
      ]
      | sort_by(.focusHistoryID // 999999)
      | .[0].address // empty
    ' || true
  )"
  [[ -n "$addr" && "$addr" != "null" ]] || return 0
  hyprctl eval "hl.dispatch(hl.dsp.focus({ window = \"address:${addr}\" }))" >/dev/null 2>&1 || true
}

focus_telegram_link "$@"

exec /usr/bin/Telegram "$@"
