#!/usr/bin/env bash
# swww transition presets (swipes, diagonals, waves, explosions, tears, slashes).
#
#   wallpaper-transition list            all preset names
#   wallpaper-transition get             current mode ("random" or a preset)
#   wallpaper-transition set <name|random>
#   wallpaper-transition cycle           random → preset1 → preset2 → … → random
#   wallpaper-transition args [name]     swww img flags (mode/random resolved if no name)
#   wallpaper-transition demo [seconds]  play every preset on random wallpapers
#
# Mode is stored in ~/.local/state/wallpaper-transition/mode.
# swww only knows line / wave / circle transitions, so "tear" and "slash" are
# emulated with jagged / hard-edged wipes at an angle.
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper-transition"
mode_file="$state_dir/mode"
last_file="$state_dir/last"
mkdir -p "$state_dir"

FPS="${WALLPAPER_TRANSITION_FPS:-120}"
EASE="0.54,0,0.34,0.99"
SNAP="0.9,0,0.1,1"
LINEAR="0,0,1,1"

# preset <name> <type> <duration> <angle> <pos> <wave> <bezier>   ("-" = swww default)
declare -A P=()
preset() { P[$1]="$2|$3|$4|$5|$6|$7"; }

# swipes
preset swipe-left  left   1.2 - - - "$EASE"
preset swipe-right right  1.2 - - - "$EASE"
preset swipe-up    top    1.2 - - - "$EASE"
preset swipe-down  bottom 1.2 - - - "$EASE"
# diagonals
for a in 30 45 60 120 135 150 210 225 240 300 315 330; do
  preset "diag-$a" wipe 1.3 "$a" - - "$EASE"
done
# waves
preset wave-soft      wave 1.6 0   -    -      "$EASE"
preset wave-soft-diag wave 1.6 45  -    40,40  "$EASE"
preset wave-tight     wave 1.4 90  -    10,10  "$EASE"
preset wave-tall      wave 1.5 0   -    8,120  "$EASE"
preset wave-rise      wave 1.6 270 -    30,60  "$EASE"
preset wave-ripple    wave 1.8 180 -    14,14  "$EASE"
# explosions (circle grows) / implosions (circle shrinks)
preset explode-center grow  1.4 - center     - "$EASE"
preset explode-tl     grow  1.5 - top-left   - "$EASE"
preset explode-tr     grow  1.5 - top-right  - "$EASE"
preset explode-bl     grow  1.5 - bottom-left  - "$EASE"
preset explode-br     grow  1.5 - bottom-right - "$EASE"
preset explode-cursor grow  1.3 - @cursor    - "$EASE"
preset explode-random grow  1.3 - @random    - "$EASE"
preset implode-center outer 1.4 - center     - "$EASE"
preset implode-cursor outer 1.3 - @cursor    - "$EASE"
preset implode-random outer 1.3 - @random    - "$EASE"
# tears (ragged wipes) and slashes (hard fast cuts)
preset tear-h     wave 1.0 0   - 6,180 "$LINEAR"
preset tear-v     wave 1.0 90  - 180,6 "$LINEAR"
preset tear-diag  wave 1.1 35  - 5,160 "$LINEAR"
preset tear-diag2 wave 1.1 145 - 5,160 "$LINEAR"
for a in 20 160 200 340; do
  preset "slash-$a" wipe 0.55 "$a" - - "$SNAP"
done
# soft
preset fade     fade   1.8 - - - "0.4,0,0.2,1"
preset dissolve simple 2   - - - -

names() { printf '%s\n' "${!P[@]}" | sort; }

cursor_pos() {
  local raw
  raw="$(hyprctl cursorpos 2>/dev/null || true)"
  raw="${raw// /}"
  [[ "$raw" =~ ^[0-9]+,[0-9]+$ ]] && printf '%s' "$raw" || printf 'center'
}

random_pos() {
  local w=2560 h=1440 dims
  dims="$(hyprctl monitors 2>/dev/null | sed -n 's/^[[:space:]]*\([0-9]\+\)x\([0-9]\+\)@.*/\1 \2/p' | head -1 || true)"
  [[ -n "$dims" ]] && read -r w h <<<"$dims"
  printf '%d,%d' $((RANDOM % w)) $((RANDOM % h))
}

emit_args() {
  local name="$1" def type dur angle pos wave bez
  def="${P[$name]:-}"
  [[ -n "$def" ]] || { echo "wallpaper-transition: unknown preset '$name'" >&2; return 1; }
  IFS='|' read -r type dur angle pos wave bez <<<"$def"
  [[ "$dur" == - ]] && dur=""; [[ "$angle" == - ]] && angle=""; [[ "$pos" == - ]] && pos=""
  [[ "$wave" == - ]] && wave=""; [[ "$bez" == - ]] && bez=""
  local -a out=(--transition-type "$type" --transition-fps "$FPS")
  [[ -n "$dur" ]] && out+=(--transition-duration "$dur")
  [[ -n "$angle" ]] && out+=(--transition-angle "$angle")
  if [[ -n "$pos" ]]; then
    case "$pos" in
      @cursor) out+=(--transition-pos "$(cursor_pos)" --invert-y) ;;
      @random) out+=(--transition-pos "$(random_pos)" --invert-y) ;;
      *) out+=(--transition-pos "$pos") ;;
    esac
  fi
  [[ -n "$wave" ]] && out+=(--transition-wave "$wave")
  [[ -n "$bez" ]] && out+=(--transition-bezier "$bez")
  [[ "$type" == "simple" ]] && out+=(--transition-step 6)
  printf '%s\n' "${out[*]}"
}

get_mode() {
  local m=random
  [[ -f "$mode_file" ]] && m="$(<"$mode_file")"
  [[ "$m" == random || -n "${P[$m]:-}" ]] || m=random
  printf '%s\n' "$m"
}

pick_random() {
  local last="" pick
  [[ -f "$last_file" ]] && last="$(<"$last_file")"
  mapfile -t all < <(names)
  local tries=0
  while :; do
    pick="${all[RANDOM % ${#all[@]}]}"
    [[ "$pick" != "$last" || ${#all[@]} -lt 2 || $((++tries)) -gt 20 ]] && break
  done
  printf '%s' "$pick" >"$last_file"
  printf '%s\n' "$pick"
}

resolve() {
  local want="${1:-}"
  [[ -n "$want" ]] || want="$(get_mode)"
  [[ "$want" == random ]] && want="$(pick_random)"
  printf '%s\n' "$want"
}

cmd="${1:-args}"
shift || true
case "$cmd" in
  list) names ;;
  get) get_mode ;;
  set)
    n="${1:-}"
    [[ "$n" == random || -n "${P[$n]:-}" ]] || { echo "unknown preset: '$n' (see: wallpaper-transition list)" >&2; exit 1; }
    printf '%s' "$n" >"$mode_file"
    echo "$n"
    ;;
  cycle)
    cur="$(get_mode)"
    mapfile -t all < <(names)
    seq=(random "${all[@]}")
    next="${seq[0]}"
    for i in "${!seq[@]}"; do
      if [[ "${seq[$i]}" == "$cur" ]]; then
        next="${seq[$(((i + 1) % ${#seq[@]}))]}"
        break
      fi
    done
    printf '%s' "$next" >"$mode_file"
    echo "$next"
    ;;
  args)
    name="$(resolve "${1:-}")"
    printf '%s' "$name" >"$last_file"
    emit_args "$name"
    ;;
  demo)
    wait_s="${1:-2}"
    wall_dir="${WALLPAPER_DIR:-$HOME/pictures/wallpapers}"
    mapfile -t files < <(find -L "$wall_dir" -type f \( -iname '*.jpg' -o -iname '*.png' -o -iname '*.webp' \))
    ((${#files[@]})) || { echo "no wallpapers in $wall_dir" >&2; exit 1; }
    pgrep -x swww-daemon >/dev/null || { swww-daemon & sleep 0.4; }
    mapfile -t all < <(names)
    for n in "${all[@]}"; do
      echo ":: $n"
      # shellcheck disable=SC2046
      swww img "${files[RANDOM % ${#files[@]}]}" $(emit_args "$n")
      sleep "$wait_s"
    done
    ;;
  *)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
