#!/usr/bin/env bash
# Wallpaper menu — wofi with thumbnails (ML4W-style look)
export PATH="$HOME/.local/bin:/usr/bin:/bin:$PATH"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

WALL_DIR="${WALLPAPER_DIR:-$HOME/pictures/wallpapers}"
LOG="$HOME/.cache/wallpaper-menu.log"
CONF="$HOME/.config/wofi/wallpaper"
mkdir -p "$HOME/.cache" "$CONF"

say() {
  hyprctl notify 1 3500 "rgb(adc6ff)" "$1" >/dev/null 2>&1 || true
  notify-send "Обои" "$1" 2>/dev/null || true
  echo "$(date +%H:%M:%S) $1" >>"$LOG"
}

echo "===== $(date) =====" >>"$LOG"

# Style close to the brown launcher/search menu
cat > "$CONF/style.css" <<'EOF'
window {
  margin: 0;
  background-color: rgba(32, 24, 18, 0.92);
  border-radius: 22px;
  border: 1px solid rgba(255, 230, 200, 0.10);
  font-family: "Adwaita Sans", "Inter", sans-serif;
}

* {
  color: #f2e8dc;
}

#input {
  margin: 16px 16px 10px 16px;
  padding: 14px 18px;
  border-radius: 999px;
  border: none;
  background-color: rgba(55, 40, 30, 0.95);
  color: #f2e8dc;
  font-size: 15px;
  box-shadow: none;
  outline: none;
}

#inner-box {
  margin: 4px 12px 16px 12px;
}

#scroll {
  margin: 0;
}

#entry {
  padding: 8px 10px;
  margin: 4px 4px;
  border-radius: 14px;
}

#entry:selected {
  background-color: rgba(90, 65, 48, 0.95);
  outline: none;
}

#text {
  margin-left: 12px;
  font-size: 14px;
}

#text:selected {
  color: #fff8f0;
}

#img {
  margin: 2px 6px 2px 2px;
  border-radius: 10px;
}
EOF

cat > "$CONF/config" <<'EOF'
width=480
height=620
location=center
prompt=Search
allow_images=true
image_size=96
insensitive=true
hide_scroll=true
gtk-dark=true
orientation=vertical
matching=contains
EOF

# Never let hyprpaper cover swww
killall -q hyprpaper 2>/dev/null || true
pgrep -x swww-daemon >/dev/null || { swww-daemon & sleep 0.5; }

mapfile -t files < <(
  find -L "$WALL_DIR" -type f \( \
    -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \
  \) 2>/dev/null | sort
)

if ((${#files[@]} == 0)); then
  say "Нет картинок в $WALL_DIR"
  exit 1
fi

# Build entries: thumbnail + readable name
# Prefer "minimal/…" names; keep unique relative paths
menu=""
for f in "${files[@]}"; do
  rel="${f#"$WALL_DIR"/}"
  menu+="img:${f}:text:${rel}"$'\n'
done

choice="$(
  printf '%s' "$menu" | wofi --dmenu     --conf "$CONF/config"     --style "$CONF/style.css"     --normal-window     --allow-images     --cache-file /dev/null
)" || true

echo "choice=[${choice:-}]" >>"$LOG"

if [[ -z "${choice:-}" ]]; then
  say "Не выбрано — кликни строку мышкой"
  exit 0
fi

# wofi usually returns the whole img:…:text:… line
selected=""
if [[ "$choice" == img:* ]]; then
  rest="${choice#img:}"
  if [[ "$rest" == *":text:"* ]]; then
    selected="${rest%%:text:*}"
  else
    selected="$rest"
  fi
elif [[ -f "$WALL_DIR/$choice" ]]; then
  selected="$WALL_DIR/$choice"
elif [[ -f "$choice" ]]; then
  selected="$choice"
fi

echo "selected=[${selected:-}]" >>"$LOG"

if [[ -z "${selected:-}" || ! -f "$selected" ]]; then
  say "Не понял выбор"
  exit 1
fi

killall -q hyprpaper 2>/dev/null || true
say "Ставлю: $(basename "$selected")"

if swww img "$selected" \
  --transition-type grow \
  --transition-duration 1.4 \
  --transition-fps 60 >>"$LOG" 2>&1
then
  say "Готово: $(basename "$selected")"
  [[ -x "$HOME/.local/bin/apply-wallpaper-theme" ]] && \
    "$HOME/.local/bin/apply-wallpaper-theme" "$selected" >/dev/null 2>&1 || true
  echo "query: $(swww query | head -1)" >>"$LOG"
else
  say "Ошибка swww"
  exit 1
fi
