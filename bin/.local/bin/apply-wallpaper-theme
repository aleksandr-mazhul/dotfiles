#!/usr/bin/env bash
# Apply wallpaper theme colors via matugen after Waypaper changes wallpaper.
#
# Pipeline: matugen (surfaces from wallpaper) → theme-warm-accents (sand UI chrome)
#           → theme-ensure-contrast (text readability only; accents stay sand).
set -euo pipefail

wallpaper="${1:-}"
# Waypaper may pass escaped paths — unquote
wallpaper="${wallpaper//\\/}"

if [[ -z "$wallpaper" || ! -f "$wallpaper" ]]; then
  echo "apply-wallpaper-theme: missing wallpaper: ${wallpaper:-<empty>}" >&2
  exit 0
fi

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
sddm_theme="/usr/share/sddm/themes/adaptive"
sddm_cache="$cfg/sddm-adaptive"
# Resolve next to this script (works via symlink from ~/.local/bin)
self_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ensure_contrast="${self_dir}/theme-ensure-contrast"
warm_accents="${self_dir}/theme-warm-accents"

mkdir -p "$sddm_cache"

# Keep hyprlock background in sync with desktop wallpaper
ln -sfn "$wallpaper" "$cfg/hypr/lock-wallpaper"

# Higher matugen contrast → safer Material roles out of the box; post-pass
# still hardens Kitty/Quickshell against translucent terminals + wild wallpapers.
matugen image "$wallpaper" \
  --mode dark \
  --type scheme-tonal-spot \
  --contrast 0.35 \
  --prefer saturation

# Pin warm sand/beige accents (wallpaper hue must not drive primary/secondary)
if [[ -x "$warm_accents" ]]; then
  "$warm_accents" || true
fi

# Auto-fix fg/dim/ANSI contrast (no per-wallpaper cfg edits)
if [[ -x "$ensure_contrast" ]]; then
  "$ensure_contrast" || true
fi

# SDDM cache is best-effort — must not abort the theme pipeline above
cp -f "$wallpaper" "$sddm_cache/background.jpg" 2>/dev/null || true

if [[ -d "$sddm_theme" && -w "$sddm_theme" ]]; then
  cp -f "$sddm_cache/background.jpg" "$sddm_theme/background.jpg"
  if [[ -f "$sddm_cache/colors.conf" ]]; then
    cp -f "$sddm_cache/colors.conf" "$sddm_theme/colors.conf"
  fi
fi

# Reload Hyprland colors without full restart of apps
hyprctl reload >/dev/null 2>&1 || true

# Reload kitty colors in live instances
if command -v kitten >/dev/null 2>&1; then
  kitten @ set-colors --all --configured ~/.config/kitty/colors-matugen.conf 2>/dev/null || true
fi

# Reload Quickshell rice colors (clipboard / launcher)
if command -v qs >/dev/null 2>&1; then
  qs -c rice ipc call theme reload 2>/dev/null \
    || { qs -c rice kill 2>/dev/null || true; qs -c rice -n -d 2>/dev/null || true; }
fi

# Reload Herdr UI colors (sand accents + wallpaper surfaces)
if command -v herdr >/dev/null 2>&1; then
  herdr server reload-config 2>/dev/null || true
fi

# Refresh hyprpolkitagent so Qt/hyprtoolkit palette picks up new colors
# (skip restart while an auth dialog is visible)
if command -v hyprctl >/dev/null 2>&1; then
  if ! hyprctl clients -j 2>/dev/null | grep -q '"class": "hyprpolkitagent"'; then
    systemctl --user try-restart hyprpolkitagent.service 2>/dev/null || true
  fi
fi

notify-send -a Waypaper "Theme updated" "$(basename "$wallpaper")" 2>/dev/null || true
