#!/usr/bin/env bash
# Block until Windscribe is connected, then replace this process with
# the given command. Used by tmux/zellij session restore so a resumed
# `claude` pane does not talk to the network before the VPN is up.
set -uo pipefail

if [[ $# -lt 1 ]]; then
  echo "usage: vpn-wait-exec COMMAND [ARG...]" >&2
  exit 2
fi

CLI="${WINDSCRIBE_CLI:-windscribe-cli}"
deadline=$(( SECONDS + ${VPN_WAIT_SECS:-300} ))

# Stow links ~/.local/bin/claude at the package file vpn-wait-provider.
# readlink -f "$0" is the package dir, not ~/.local/bin, so both must be
# skipped or the lookup execs the wrapper again.
resolve_cmd() {
  local cmd="$1"
  if [[ "$cmd" == */* ]]; then
    printf '%s' "$cmd"
    return 0
  fi
  local self_real self_dir invoked_dir provider_real dir canon cand cand_real
  self_real="$(readlink -f "$0")"
  self_dir="$(dirname "$self_real")"
  invoked_dir="$(cd "$(dirname "$0")" && pwd)"
  provider_real="$(readlink -f "$self_dir/vpn-wait-provider" 2>/dev/null || true)"
  local IFS=:
  for dir in $PATH; do
    [[ -n "$dir" ]] || continue
    canon="$(cd "$dir" 2>/dev/null && pwd)" || continue
    [[ "$canon" == "$self_dir" || "$canon" == "$invoked_dir" ]] && continue
    cand="$canon/$cmd"
    [[ -x "$cand" && ! -d "$cand" ]] || continue
    cand_real="$(readlink -f "$cand" 2>/dev/null || true)"
    [[ -n "$provider_real" && "$cand_real" == "$provider_real" ]] && continue
    [[ "$cand_real" == "$self_real" ]] && continue
    printf '%s' "$cand_real"
    return 0
  done
  return 1
}

while (( SECONDS < deadline )); do
  st="$("$CLI" status 2>/dev/null || true)"
  if [[ "${st,,}" == *"connect state: connected"* ]]; then
    real="$(resolve_cmd "$1")" || {
      echo "vpn-wait-exec: not found: $1" >&2
      exit 127
    }
    shift
    exec "$real" "$@"
  fi
  sleep 1
done

echo "vpn-wait-exec: VPN did not connect, not starting: $*" >&2
exit 1
