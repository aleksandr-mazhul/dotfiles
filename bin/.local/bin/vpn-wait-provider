#!/usr/bin/env bash
# PATH name for an AI client. Waits for the VPN, then runs the real binary.
# Symlink this file as claude, claude-desktop, chatgpt, devin-desktop, codex,
# gemini, or copilot (`gh copilot` execs whatever `copilot` is on PATH).
set -uo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
name="$(basename "$0")"

# "Open Claude" in the browser re-runs this launcher with a claude:// URL.
# The running app only requests activation, and focus_on_activate stays off
# so a notification cannot steal the workspace. Focus the tiled window here,
# the same way Zen and Telegram do. No URL means autostart: stay put.
focus_claude_link() {
  local arg has_url=0 addr=""
  for arg in "$@"; do
    case "$arg" in
      *://*) has_url=1 ;;
    esac
  done
  [[ "$has_url" -eq 1 ]] || return 0
  command -v hyprctl >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  addr="$(
    hyprctl -j clients 2>/dev/null | jq -r '
      [ .[]
        | select(.class == "com.anthropic.Claude")
        | select(.mapped != false and .floating != true)
      ]
      | sort_by(.focusHistoryID // 999999)
      | .[0].address // empty
    ' || true
  )"
  [[ -n "$addr" && "$addr" != "null" ]] || return 0
  hyprctl eval "hl.dispatch(hl.dsp.focus({ window = \"address:${addr}\" }))" >/dev/null 2>&1 || true
}

case "$name" in
  vpn-wait-provider)
    echo "usage: invoke via a provider name (claude, copilot, devin-desktop, …)" >&2
    exit 2
    ;;
  claude-desktop)
    focus_claude_link "$@"
    ;;
  copilot)
    real="${COPILOT_BIN:-$HOME/.local/libexec/copilot}"
    if [[ ! -x "$real" ]]; then
      echo "copilot binary not found: $real" >&2
      exit 127
    fi
    exec "$here/vpn-wait-exec" "$real" "$@"
    ;;
esac

exec "$here/vpn-wait-exec" "$name" "$@"
