#!/bin/bash
# Always use the configured Zen profile, sync tracked shortcut prefs, and inject
# current SSOT Vimium CSS BEFORE Zen reads extension storage (and repair AFTER
# exit — Zen may flush stale in-memory settings back on shutdown).
set -euo pipefail

profile="${ZEN_PROFILE:-$HOME/.config/zen/iqy4nxax.Default (release)}"
zen_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/zen"
render="${HOME}/.local/bin/theme-render"
[[ -x "$render" ]] || render="${HOME}/dotfiles/bin/.local/bin/theme-render"
log="${XDG_CACHE_HOME:-$HOME/.cache}/theme-vimium.log"
mkdir -p "$(dirname "$log")" "$profile"

sync_tracked() {
  # Canonical copies live in ~/.config/zen/ (stowed from dotfiles/zen)
  local src dst
  src="$zen_cfg/zen-keyboard-shortcuts.json"
  dst="$profile/zen-keyboard-shortcuts.json"
  if [[ -f "$src" ]]; then
    cp -f "$src" "$dst"
  fi
  src="$zen_cfg/user.js"
  dst="$profile/user.js"
  if [[ -f "$src" ]]; then
    cp -f "$src" "$dst"
  fi
  # Chrome assets (tracked under zen/.../chrome; copied into profile each launch).
  mkdir -p "$profile/chrome"
  local chrome_src=""
  if [[ -d "$zen_cfg/chrome" ]]; then
    chrome_src="$zen_cfg/chrome"
  elif [[ -d "$HOME/dotfiles/zen/.config/zen/chrome" ]]; then
    chrome_src="$HOME/dotfiles/zen/.config/zen/chrome"
  fi
  if [[ -n "$chrome_src" ]]; then
    cp -f "$chrome_src"/autoscroll.css "$chrome_src"/autoscroll*.svg "$profile/chrome/" 2>/dev/null || true
    if [[ -f "$chrome_src/userChrome.css" ]]; then
      cp -f "$chrome_src/userChrome.css" "$profile/chrome/userChrome.css"
    fi
    if [[ -f "$chrome_src/userContent.css" ]]; then
      cp -f "$chrome_src/userContent.css" "$profile/chrome/userContent.css"
    fi
  fi
}

sync_vimium() {
  local why="$1"
  {
    echo "---- $(date -Iseconds) sync ($why) ----"
    if [[ -x "$render" ]]; then
      "$render" --vimium-only || echo "theme-render failed: $?"
    else
      echo "theme-render not found at $render"
    fi
  } >>"$log" 2>&1 || true
}

sync_tracked
sync_vimium "pre-launch"

# A second Zen process usually only adds a tab and never asks Hyprland to focus
# the existing window. Switch to that workspace before handing it the URL.
# No-op without a URL so session autostart does not jump to Zen.
focus_open_zen() {
  local arg has_url=0 addr=""
  for arg in "$@"; do
    case "$arg" in
      *://*) has_url=1 ;;
    esac
  done
  [[ "$has_url" -eq 1 ]] || return 0
  command -v hyprctl >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  addr="$(
    hyprctl -j clients 2>/dev/null | jq -r '
      [ .[]
        | select(.class == "zen" or .class == "zen-browser" or .class == "Zen" or .class == "Zen-browser")
        | select(.title != "Picture-in-Picture" and .title != "Картинка в картинке")
        | select(.mapped != false and .floating != true)
      ]
      | sort_by(.focusHistoryID // 999999)
      | .[0].address // empty
    ' || true
  )"
  [[ -n "$addr" && "$addr" != "null" ]] || return 0
  hyprctl eval "hl.dispatch(hl.dsp.focus({ window = \"address:${addr}\" }))" >/dev/null 2>&1 || true
}

focus_open_zen "$@"

# Don't use exec — we need a post-exit sync after Zen overwrites storage.js
set +e
/opt/zen-browser-bin/zen-bin --profile "$profile" "$@"
status=$?
set -e

sync_vimium "post-exit"

# Pull shortcut edits made inside Zen back into the tracked canonical file
if [[ -f "$profile/zen-keyboard-shortcuts.json" ]]; then
  cp -f "$profile/zen-keyboard-shortcuts.json" "$zen_cfg/zen-keyboard-shortcuts.json" 2>/dev/null || true
fi

exit "$status"
