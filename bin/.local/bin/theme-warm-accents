#!/usr/bin/env python3
"""Deprecated: sand accents are now chosen by the SSOT theme pipeline.

Kept as a no-op compatibility stub so old hooks don't fail.
Use: apply-wallpaper-theme → theme-extract/match/build/render
"""
from __future__ import annotations

import sys


def main() -> int:
    print(
        "theme-warm-accents: deprecated — SSOT pipeline owns accents "
        "(~/.config/theme/palette.toml)",
        file=sys.stderr,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
